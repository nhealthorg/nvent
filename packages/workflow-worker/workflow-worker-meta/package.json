    "@nvent-addon/workflow-worker-linux-arm64-musl": "1.0.0",
    "@nvent-addon/workflow-worker-darwin-x64": "1.0.0",
    "@nvent-addon/workflow-worker-darwin-arm64": "1.0.0",
    "@nvent-addon/workflow-worker-win32-x64-msvc": "1.0.0"
