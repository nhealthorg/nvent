{
  "name": "nvent-monorepo",
  "version": "1.0.0-alpha.20",
  "description": "Event-driven workflows for Nuxt - Monorepo",
  "repository": "https://github.com/nhealthorg/nvent",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm prepare && pnpm --filter \"./packages/app\" --filter \"./packages/nvent\" prepack",
    "build:stub": "pnpm prepare",
    "build:worker": "cargo build --manifest-path workers/workflow/Cargo.toml",
    "build:worker:test": "cargo test --manifest-path workers/workflow/Cargo.toml",
    "build:worker:package": "node scripts/build-workflow-worker-package.mjs && pnpm prepare",
    "pack:worker:meta": "pnpm -C packages/workflow-worker/workflow-worker-meta pack",
    "pack:worker:linux-x64": "pnpm -C packages/workflow-worker/workflow-worker-linux-x64-gnu pack",
    "prepare": "pnpm --filter \"./packages/app\" --filter \"./packages/nvent\" run build --stub && nuxi prepare playground",
    "dev": "nuxi dev playground --clear",
    "dev:iii": "playground/node_modules/.nvent/bin/iii -c playground/.nuxt/iii-config.yaml",
    "dev:console": "playground/node_modules/.nvent/bin/iii-console --engine-port 3111 --ws-port 3112 --bridge-port 49134",
    "dev:build": "nuxi build playground",
    "dev:preview": "NVENT_PYTHON_BIN=playground/.venv/bin/python3 nuxi preview playground",
    "test": "vitest run",
    "test:unit": "vitest test/unit",
    "test:e2e": "vitest test/e2e",
    "test:coverage": "vitest --coverage",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "lint": "eslint --ext .ts,.js,.mjs,.cjs,.vue .",
    "cleanup": "rimraf dist*/ node_modules .nuxt* playground/.data playground/.output playground/node_modules packages/**/dist packages/**/node_modules",
    "bumpp": "bumpp --recursive"
  },
  "resolutions": {
		"@nvent-addon/app": "workspace:*",
    "@nvent-addon/workflow-worker": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.3.1",
    "@nuxt/eslint-config": "1.16.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "4.5.1",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "^26.1.2",
    "bumpp": "11.1.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.1",
    "nuxi": "^3.37.0",
    "nuxt-mcp": "0.2.6",
    "rimraf": "^6.1.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@10.20.0"
}
